# ============================================================
# AVH Store — Environment Variables (NO SECRETS — for .env.example)
# Copy this file to .env (local dev) OR set these in Netlify dashboard:
#   Site → Settings → Environment variables
# ============================================================

# === DATABASE (required for production) =====================
# PostgreSQL connection string. SQLite (file:./db/custom.db) only works
# in the dev sandbox — Vercel's filesystem is read-only at runtime and
# SQLite files CANNOT be deployed there.
#
# Supabase → Project Settings → Database → Connection string.
# ⚠ Use the POOLED connection (Transaction pooler, port 6543) for
#   serverless/Vercel — the DIRECT host (db.<ref>.supabase.co, port 5432)
#   is IPv6-only and Vercel functions cannot reach it.
#   Copy-paste format (pooler, serverless):
#     postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   src/lib/db.ts auto-appends pgbouncer=true&statement_cache_size=0 for
#   port 6543, so no extra query params are required.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# === SUPABASE PLATFORM (optional — JS client helpers) =======
# Used by src/lib/supabase/client.ts (browser) and src/lib/supabase/server.ts
# (server) for Supabase platform features: Storage, Realtime, Auth.
# The main DATABASE (Prisma) does NOT depend on these.
# Both values are PUBLIC by design — safe to expose in the browser.
#   Project URL:    https://<project-ref>.supabase.co
#   Publishable key: Project Settings → API Keys → "sb_publishable_..."
# NEVER put the secret key (sb_secret_...) into a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Server-only secret key (Storage admin ops / service-role queries).
# Set on Vercel ONLY — never expose to the browser, never commit.
# SUPABASE_SECRET_KEY="sb_secret_xxx"

# LOCAL DEV ONLY — SQLite via the dev schema (provider=sqlite):
#   bun run db:dev   (push + generate from prisma/schema.dev.prisma)
# Vercel build keeps using prisma/schema.prisma (provider=postgresql).
# For local dev point DATABASE_URL to a file instead, e.g.:
#   DATABASE_URL="file:./db/custom.db"

# === AUTH (required) ========================================
# NextAuth JWT signing secret. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-32-char-secret"

# Public URL of the deployed site. On Vercel: https://your-site.vercel.app
# OR your custom domain: https://noithatavh.vn
# Used by NextAuth for OAuth callbacks + by SEO surfaces (canonical links,
# Open Graph tags, sitemap.xml, robots.txt). Set NEXT_PUBLIC_SITE_URL so
# shared product URLs (/san-pham/<slug>) always carry your real domain.
NEXTAUTH_URL="https://your-site.vercel.app"
NEXT_PUBLIC_SITE_URL="https://your-site.vercel.app"

# === GOOGLE OAUTH (optional — uncomment to enable Google login) ===
# Create OAuth client: https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# === APPLE SIGN IN (optional) ===============================
# APPLE_CLIENT_ID="com.yourcompany.noithat-avh"
# APPLE_SECRET="-----BEGIN PRIVATE KEY-----..."

# === PAYMENTS — INTERNAL WEBHOOK SECRET (required) ==========
# Used by /api/orders/[code]/pay route to verify internal webhook calls
# (e.g. when a payment gateway provider posts back). Generate a random
# 32-char string.
PAYMENT_WEBHOOK_SECRET="generate-a-random-secret"

# === SEPAY — bank transfer auto-confirmation webhook =======
# Sepay is a Vietnamese bank-transfer webhook service that notifies your
# site when a customer's bank transfer lands in your merchant account.
# Create account: https://sepay.vn
# Configure webhook URL in Sepay dashboard:
#   https://YOUR_DOMAIN/api/payments/sepay/webhook
# Sepay signs the body with HMAC-SHA256 using SEPAY_WEBHOOK_SECRET.
SEPAY_API_TOKEN="your-sepay-api-token"
SEPAY_WEBHOOK_SECRET="your-sepay-webhook-hmac-secret"

# === MoMo (optional) ========================================
# Vietnamese e-wallet gateway.
# MOMO_PARTNER_CODE="MOMO_PARTNER_CODE"
# MOMO_ACCESS_KEY="MOMO_ACCESS_KEY"
# MOMO_SECRET_KEY="MOMO_SECRET_KEY"

# === VNPay (optional) =======================================
# Vietnamese national payment gateway.
# VNP_TMN_CODE="VNP_TMN_CODE"
# VNP_HASH_SECRET="VNP_HASH_SECRET"

# === ZaloPay (optional) =====================================
# ZaloPay e-wallet.
# ZALOPAY_APP_ID="ZALOPAY_APP_ID"
# ZALOPAY_KEY="ZALOPAY_KEY"

# === CLOUDINARY — file upload storage (required for production) ===
# All customer-uploaded files (product images, transfer slips) are stored
# in Cloudinary. Free tier: 25 credits (= ~25GB storage + bandwidth).
# Create account: https://cloudinary.com → Dashboard → copy credentials.
#
# Option A (recommended): use the unified CLOUDINARY_URL env var.
#   Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL="cloudinary://..."
#
# Option B: separate env vars.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
#
# If NONE of these are set, the app falls back to local /public/uploads/
# (works only in dev sandbox — uploads are LOST on Netlify).

# === AI CHAT — Groq (preferred — fast + free tier) =========================
# Get a free API key at https://console.groq.com → API Keys.
# Groq is OpenAI-compatible — uses the same `openai` npm SDK + Groq's endpoint.
# Free tier: 30 req/min, 14400 req/day — enough for a small e-commerce chatbot.
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
# Default model. "groq/compound" supports built-in tools (web_search,
# code_interpreter, visit_website) — same as your provided model spec.
# Other free models: "llama-3.3-70b-versatile", "llama-3.1-8b-instant".
GROQ_MODEL="groq/compound"

# === AI CHAT — z.ai SDK (LEGACY FALLBACK — sandbox only) ====================
# The z-ai-web-dev-sdk reads from a .z-ai-config file at the project root.
# `scripts/setup-zai-config.js` generates this file at build time from
# the env vars below. NEVER commit a real .z-ai-config file.
#
# Groq is preferred — this section is only used if GROQ_API_KEY is unset.
# (e.g. in the sandbox environment where z.ai is pre-configured.)
# ZAI_API_KEY="your-zai-api-key"
# ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
# ZAI_CHAT_ID="optional-chat-id"
